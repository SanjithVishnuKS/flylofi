# System & OS
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
*.venv/
env/
venv/

# Large Media Binaries (>100MB limit for GitHub)
media/*.mkv
media/*.avi
media/*.mov
media/flight/clips/night-flight-lofi.mp4
media/flight/videos/first-class-cabin.mp4
# Allow lightweight production media (<50MB)
!media/flight/clips/gemini_generated_video_09c1b3d1.mp4
!media/flight/audio/*.webm

# Huge raw master audio recordings (>100MB)
media/flight/audio/*.orig.webm
!focus-flight/media/**

# Keep directory structure
!media/**/.gitkeep

# Keystore & Certificates
*.pem
*.p12
*.keystore
*.jks
.idea/
.vscode/
*.log
*.tmp
clean-base.apk
